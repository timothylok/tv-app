# Copy to .env and fill in. Same names are used as GitHub Actions secrets.
# R2_ENDPOINT looks like https://<account-id>.r2.cloudflarestorage.com (no bucket name)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-tv-channels
R2_PUBLIC_BASE_URL=
# Cloudflare Workers AI (free tier) for the script LLM. Token needs the Workers AI permission.
CLOUDFLARE_API_TOKEN=
# Account Analytics: Read, this account only. Lets the pipeline check its spend against Cloudflare's own figures.
CLOUDFLARE_ANALYTICS_TOKEN=
